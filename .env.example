# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Eagle Trading Zone FX Book

# AI Provider (optional — leave empty for rule-based reports)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Email Delivery (Choose Option 1 or Option 2 for 100% Free Live Emails)
# Option 1 (Recommended - Resend.com 3,000 free emails/month):
RESEND_API_KEY=
RESEND_FROM=Eagle Trading Zone <onboarding@resend.dev>

# Option 2 (Gmail SMTP - use your Gmail + 16-character Google App Password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Eagle Trading Zone <noreply@eagletradingzone.com>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
